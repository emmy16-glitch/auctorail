# Never commit real values below.
TELEGRAPH_EVM_PRIVATE_KEY=
PROOFGATE_SECRET=

# Public infrastructure configuration.
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine
BASE_SEPOLIA_RPC_URL=https://sepolia-preconf.base.org
EVM_NETWORK=eip155:84532

# Try ProofGate web API.
PROOFGATE_WEB_API_PORT=8787
PROOFGATE_WEB_ORIGINS=http://localhost:5173
PROOFGATE_TRUST_PROXY=false

# Live Telegraph is intentionally opt-in. Keep false until the public
# deployment has a funded, low-balance evidence wallet and rate limits set.
PROOFGATE_LIVE_AUTHORIZATION_ENABLED=false
PROOFGATE_POLICY_REQUESTS_PER_MINUTE=30
PROOFGATE_LIVE_REQUESTS_PER_HOUR=3
PROOFGATE_LIVE_DAILY_BUDGET_RAW=500000

# Optional browser API origin for split frontend/API deployments.
# Leave empty during local development; Vite proxies /api to port 8787.
VITE_PROOFGATE_API_URL=
