# Never commit real values below.
TELEGRAPH_EVM_PRIVATE_KEY=
AUCTORAIL_SECRET=

# Public infrastructure configuration.
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine
BASE_SEPOLIA_RPC_URL=https://sepolia-preconf.base.org
EVM_NETWORK=eip155:84532

# Auctorail web APIs.
AUCTORAIL_WEB_API_PORT=8787
AUCTORAIL_SECURITY_LAB_PORT=8788
AUCTORAIL_WEB_ORIGINS=http://localhost:5173
AUCTORAIL_TRUST_PROXY=false

# Optional override for the executor operation journal. Leave empty normally.
# Serverless runtimes such as Vercel/Lambda automatically use /tmp/auctorail/operations.
AUCTORAIL_OPERATION_JOURNAL_DIR=

# Live payment authorization is intentionally opt-in. Keep false until the
# deployment has a funded, low-balance evidence wallet and rate limits set.
AUCTORAIL_LIVE_AUTHORIZATION_ENABLED=false
AUCTORAIL_POLICY_REQUESTS_PER_MINUTE=30
AUCTORAIL_LIVE_REQUESTS_PER_HOUR=50
AUCTORAIL_LIVE_DAILY_BUDGET_RAW=500000

# Content Trust has its own explicit live switch and a strict per-check x402
# cap. Demo mode and receipt verification do not spend Telegraph funds.
# Live mode is ON by default; set false to restrict to the free demo mode.
AUCTORAIL_CONTENT_LIVE_ENABLED=true
AUCTORAIL_CONTENT_MAX_SPEND_RAW=50000
AUCTORAIL_CONTENT_REQUESTS_PER_HOUR=5

# Optional browser origins for split deployments. Leave empty during local
# development; Vite proxies payment calls to 8787 and utility calls to 8788.
VITE_AUCTORAIL_API_URL=
VITE_AUCTORAIL_UTILITY_API_URL=

# Legacy compatibility only. The current product name and public configuration
# namespace are AUCTORAIL_*. Keep these aliases only while migrating an older
# deployment that still expects PROOFGATE_* variables.
PROOFGATE_SECRET=
PROOFGATE_WEB_API_PORT=
PROOFGATE_WEB_ORIGINS=
PROOFGATE_TRUST_PROXY=
PROOFGATE_LIVE_AUTHORIZATION_ENABLED=
PROOFGATE_POLICY_REQUESTS_PER_MINUTE=
PROOFGATE_LIVE_REQUESTS_PER_HOUR=
PROOFGATE_LIVE_DAILY_BUDGET_RAW=
PROOFGATE_OPERATION_JOURNAL_DIR=
VITE_PROOFGATE_API_URL=
