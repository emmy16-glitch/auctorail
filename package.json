{
  "name": "proof-gate",
  "version": "1.0.0",
  "description": "Risk-adaptive authorization firewall for autonomous agents using Telegraph intelligence.",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev",
    "proof:live": "tsx scripts/prove-telegraph.ts",
    "proof:adaptive": "tsx scripts/prove-adaptive.ts",
    "policy": "tsx scripts/show-policy-decision.ts",
    "wallet:check": "node scripts/check-wallet.mjs",
    "vendor:compile": "node scripts/compile-vendor.mjs",
    "vendor:verify": "node scripts/verify-vendor-artifact.mjs",
    "vendor:deploy": "tsx scripts/deploy-vendor.ts",
    "signal:verify": "tsx scripts/verify-telegraph-signal.ts",
    "execute:approved": "tsx scripts/execute-approved-payment.ts",
    "attack:lab": "tsx scripts/attack-lab.ts",
    "security:fuzz": "tsx scripts/final-fuzz.ts",
    "security:fuzz:adaptive": "tsx scripts/adaptive-fuzz.ts",
    "security:fuzz:general": "tsx scripts/general-fuzz.ts",
    "gateway:serve": "tsx scripts/serve-authorization-gateway.ts",
    "proof:reprocess": "tsx scripts/reprocess-quarantine.ts",
    "test:postgres": "tsx scripts/test-postgres.ts"
  },
  "keywords": [
    "telegraph",
    "ai-agents",
    "authorization",
    "x402",
    "security"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "viem": "^2.56.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
