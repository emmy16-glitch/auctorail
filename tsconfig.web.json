{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "vite.config.ts"]
}
